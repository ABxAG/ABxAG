# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Event-driven cognition (all processing is local unless a goal explicitly
# invokes the configured model router).
ABxAG_ENABLE_COGNITION=true
ABxAG_ENABLE_INITIATIVE=true
ABxAG_ENABLE_PROACTIVE_SPEECH=true
ABxAG_ENABLE_SKILL_LEARNING=true
ABxAG_ENABLE_REFLECTION=true
ABxAG_ENABLE_DESKTOP_AWARENESS=true
ABxAG_ENABLE_SCREEN_AWARENESS=false
PAUSE_AUTONOMY=false
ABxAG_COGNITION_DEBUG=false

# Model capability routes. Comma-separate one fallback at most.
ABxAG_FAST_MODEL=gemini-3.5-flash
ABxAG_REASONING_MODEL=gemini-3.5-flash
ABxAG_CODE_MODEL=gemini-3.5-flash
ABxAG_VISION_MODEL=gemini-3.1-flash-live-preview
ABxAG_EMBEDDING_MODEL=gemini-embedding-001
ABxAG_SPEECH_MODEL=gemini-3.1-flash-live-preview

# Explicit local capability permissions.
ABxAG_PERMISSION_MICROPHONE=true
ABxAG_PERMISSION_SCREEN_AWARENESS=true
ABxAG_PERMISSION_FILESYSTEM_READ=true
ABxAG_PERMISSION_FILESYSTEM_WRITE=true
ABxAG_PERMISSION_DESKTOP_CONTROL=true
ABxAG_PERMISSION_BROWSER=true
ABxAG_PERMISSION_NETWORK=true
ABxAG_PERMISSION_AUTOMATION=true
ABxAG_PERMISSION_CODE_EXECUTION=true
ABxAG_PERMISSION_SYSTEM_CONTROL=true

# Runaway/cost limits.
ABxAG_MAX_PLAN_DEPTH=8
ABxAG_MAX_RETRIES=2
ABxAG_MAX_TOOL_CALLS=24
ABxAG_TASK_TIMEOUT_MS=300000
ABxAG_REPETITION_COOLDOWN_MS=180000

# Public API capability catalogue (backend-only; providers are not all exposed to the model)
ABxAG_API_CATALOGUE_SYNC=true
ABxAG_PUBLIC_APIS_URL=https://raw.githubusercontent.com/public-apis/public-apis/master/README.md
ABxAG_API_CATALOGUE_MAX_AGE_MS=86400000
ABxAG_API_HEALTH_TIMEOUT_MS=8000



